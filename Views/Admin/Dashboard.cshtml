@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>Admin Dashboard</h1>
        <p class="text-muted">
            Pharmacy Management System
        </p>
    </div>

    <div class="row">

        <!-- User Management -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">User Management</h4>

                    <p class="card-text">
                        Manage administrators, pharmacists and staff.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>

        <!-- Medicine Management -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Medicine Management</h4>

                    <p class="card-text">
                        Add, edit, delete and search medicines.
                    </p>

                    <a asp-controller="Medicine"
                       asp-action="Index"
                       class="btn btn-success">
                        Manage Medicines
                    </a>
                </div>
            </div>
        </div>

        <!-- Inventory -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Inventory</h4>

                    <p class="card-text">
                        Monitor stock, batches and expiry dates.
                    </p>

                    <a href="#" class="btn btn-warning">
                        View Inventory
                    </a>
                </div>
            </div>
        </div>

        <!-- Sales -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Sales & Billing</h4>

                    <p class="card-text">
                        Manage sales, billing and invoices.
                    </p>

                    <a href="#" class="btn btn-info">
                        View Sales
                    </a>
                </div>
            </div>
        </div>

        <!-- Suppliers -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Suppliers</h4>

                    <p class="card-text">
                        Manage suppliers and purchase records.
                    </p>

                    <a href="#" class="btn btn-secondary">
                        Manage Suppliers
                    </a>
                </div>
            </div>
        </div>

        <!-- Reports -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Reports & Analytics</h4>

                    <p class="card-text">
                        View pharmacy reports and analytics.
                    </p>

                    <a href="#" class="btn btn-dark">
                        View Reports
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>