@model PharmacyManagmentSystem.Models.Prescription

@{
    ViewData["Title"] = "Delete Prescription";
}

<h1>Delete Prescription</h1>

<h3>Are you sure you want to delete this prescription?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Prescription Number
        </dt>
        <dd class="col-sm-9">
            @Model.PrescriptionNumber
        </dd>

        <dt class="col-sm-3">
            Patient Name
        </dt>
        <dd class="col-sm-9">
            @Model.PatientName
        </dd>

        <dt class="col-sm-3">
            Doctor
        </dt>
        <dd class="col-sm-9">
            @Model.DoctorName
        </dd>

        <dt class="col-sm-3">
            Date
        </dt>
        <dd class="col-sm-9">
            @Model.PrescriptionDate.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>
        <dd class="col-sm-9">
            @Model.Status
        </dd>

        <dt class="col-sm-3">
            Items
        </dt>
        <dd class="col-sm-9">
            @Model.PrescriptionItems.Count medicine(s)
        </dd>
    </dl>

    @if (Model.PrescriptionItems.Any())
    {
        <h5>Prescribed Medicines:</h5>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Dosage</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PrescriptionItems)
                {
                    <tr>
                        <td>@item.Medicine?.MedicineName</td>
                        <td>@item.Dosage</td>
                        <td>@item.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.PrescriptionId" />

        <input type="submit" value="Delete" class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
