@model IEnumerable<PharmacyManagmentSystem.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions";
}

<h1>Prescriptions</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New Prescription</a>
    <a asp-action="History" class="btn btn-outline-primary">Patient History</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       name="searchString"
                       value="@ViewData["SearchString"]"
                       class="form-control"
                       placeholder="Search by patient, prescription number or doctor" />
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Clear</a>
            </div>
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Statuses --</option>
                <option value="Pending" selected="@(ViewData["StatusFilter"]?.ToString() == "Pending")">Pending</option>
                <option value="Verified" selected="@(ViewData["StatusFilter"]?.ToString() == "Verified")">Verified</option>
                <option value="Dispensed" selected="@(ViewData["StatusFilter"]?.ToString() == "Dispensed")">Dispensed</option>
                <option value="Cancelled" selected="@(ViewData["StatusFilter"]?.ToString() == "Cancelled")">Cancelled</option>
            </select>
        </div>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Prescription #</th>
            <th>Patient Name</th>
            <th>Age</th>
            <th>Doctor</th>
            <th>Date</th>
            <th>Status</th>
            <th>Items</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PrescriptionNumber</td>
                <td>@item.PatientName</td>
                <td>@item.PatientAge</td>
                <td>@item.DoctorName</td>
                <td>@item.PrescriptionDate.ToString("dd-MM-yyyy")</td>
                <td>
                    @switch (item.Status)
                    {
                        case PharmacyManagmentSystem.Models.PrescriptionStatus.Pending:
                            <span class="badge bg-warning text-dark">Pending</span>
                            break;
                        case PharmacyManagmentSystem.Models.PrescriptionStatus.Verified:
                            <span class="badge bg-info">Verified</span>
                            break;
                        case PharmacyManagmentSystem.Models.PrescriptionStatus.Dispensed:
                            <span class="badge bg-success">Dispensed</span>
                            break;
                        case PharmacyManagmentSystem.Models.PrescriptionStatus.Cancelled:
                            <span class="badge bg-secondary">Cancelled</span>
                            break;
                    }
                </td>
                <td>@item.PrescriptionItems.Count</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.PrescriptionId">Details</a>

                    @if (item.Status == PharmacyManagmentSystem.Models.PrescriptionStatus.Pending)
                    {
                        <text> | </text>
                        <a asp-action="Verify"
                           asp-route-id="@item.PrescriptionId">Verify</a>
                    }

                    <text> | </text>
                    <a asp-action="Delete"
                       asp-route-id="@item.PrescriptionId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
