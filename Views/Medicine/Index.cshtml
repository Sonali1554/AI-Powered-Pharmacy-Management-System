@model IEnumerable<PharmacyManagmentSystem.Models.Medicine>
@{
    ViewData["Title"] = "Medicine Management";
}

<div class="container mt-4 animate-fade-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-gradient" style="color: var(--accent-primary);"><i class="fa-solid fa-boxes-stacked me-2"></i> Inventory</h2>
            <p class="text-muted">Manage medicines in the pharmacy.</p>
        </div>
        
        <a asp-action="Create" class="btn-nexus text-decoration-none" style="display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus"></i> Add Medicine
        </a>
    </div>

    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table-nexus">
                <thead>
                    <tr>
                        <th>Medicine Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Expiry Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold" style="color: var(--text-main)"><i class="fa-solid fa-capsules me-2" style="color: var(--accent-primary)"></i>@item.Name</td>
                                <td><span class="badge" style="background-color: var(--card-bg); color: var(--text-muted); border: 1px solid var(--border-color);">@item.Category</span></td>
                                <td style="color: var(--accent-secondary); font-weight: bold;">@item.Price.ToString("C", new System.Globalization.CultureInfo("hi-IN"))</td>
                                <td>
                                    @if(item.StockQuantity > 10)
                                    {
                                        <span class="badge" style="background: rgba(29, 179, 110, 0.1); color: var(--accent-secondary); border-radius: 12px; padding: 6px 12px;">@item.StockQuantity In Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 12px; padding: 6px 12px;">@item.StockQuantity Low Stock</span>
                                    }
                                </td>
                                <td><span class="text-muted">@item.ExpiryDate.ToString("yyyy-MM-dd")</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">No medicines in inventory. Click "Add Medicine" to begin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>