@{
    ViewData["Title"] = "Medicine Management";
}

<div class="container mt-4">
    <h1>Medicine Management</h1>

    <p>Manage medicines in the pharmacy.</p>

    <button class="btn btn-success">Add Medicine</button>

    <hr />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Medicine Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Expiry Date</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>Paracetamol</td>
                <td>Tablet</td>
                <td>₹20</td>
                <td>100</td>
                <td>2027-05-10</td>
            </tr>
        </tbody>
    </table>
</div>