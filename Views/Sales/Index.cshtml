@model IEnumerable<PharmacyManagmentSystem.Models.Sale>

    @{
    ViewData["Title"] = "Sales History";
    }

    <div class="container mt-4 animate-fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-gradient"><i class="fa-solid fa-clock-rotate-left me-2"></i> Sales History</h2>

            <a asp-action="Create" class="btn-nexus">
                <i class="fa-solid fa-plus me-1"></i> New Bill
            </a>
        </div>

        @if (!Model.Any())
    {
        <div class="alert alert-info">
            No sales recorded yet.
        </div>
    }
    else
    {
        <div class="glass-card p-4">
            <div class="table-responsive">
                <table class="table-nexus">
                    <thead>
                        <tr>
                            <th>Bill ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Payment</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var sale in Model)
                        {
                        <tr>
                            <td><span class="text-muted">#@sale.SaleId</span></td>
                            <td><i class="fa-solid fa-user text-primary me-2"></i>@sale.Customer?.Name</td>
                            <td>@sale.SaleDate.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>₹@sale.Subtotal.ToString("0.00")</td>
                            <td><span class="badge bg-info bg-opacity-25 text-info">@sale.DiscountPercentage%</span></td>
                            <td class="text-success fw-bold">₹@sale.TotalAmount.ToString("0.00")</td>
                            <td>@sale.PaymentMethod</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@sale.SaleId"
                                   class="btn-nexus-outline btn-sm" style="padding: 5px 10px;">
                                    <i class="fa-solid fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    </div>
