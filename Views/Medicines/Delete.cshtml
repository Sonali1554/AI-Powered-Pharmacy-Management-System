@model PharmacyManagmentSystem.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<h1>Delete Medicine</h1>

<h3>Are you sure you want to delete this medicine?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Medicine Name
        </dt>
        <dd class="col-sm-9">
            @Model.MedicineName
        </dd>

        <dt class="col-sm-3">
            Category
        </dt>
        <dd class="col-sm-9">
            @Model.Category?.CategoryName
        </dd>

        <dt class="col-sm-3">
            Manufacturer
        </dt>
        <dd class="col-sm-9">
            @Model.Manufacturer
        </dd>

        <dt class="col-sm-3">
            Batch Number
        </dt>
        <dd class="col-sm-9">
            @Model.BatchNumber
        </dd>

        <dt class="col-sm-3">
            Expiry Date
        </dt>
        <dd class="col-sm-9">
            @Model.ExpiryDate.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">
            Purchase Price
        </dt>
        <dd class="col-sm-9">
            @Model.PurchasePrice
        </dd>

        <dt class="col-sm-3">
            Selling Price
        </dt>
        <dd class="col-sm-9">
            @Model.SellingPrice
        </dd>

        <dt class="col-sm-3">
            Quantity
        </dt>
        <dd class="col-sm-9">
            @Model.Quantity
        </dd>

        <dt class="col-sm-3">
            Reorder Level
        </dt>
        <dd class="col-sm-9">
            @Model.ReorderLevel
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="medicineid" value="@Model.MedicineId" />

        <input type="submit" value="Delete" class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
