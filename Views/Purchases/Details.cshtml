@model PharmacyManagmentSystem.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<h1>Purchase Details</h1>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Invoice Number
        </dt>
        <dd class="col-sm-9">
            @Model.InvoiceNumber
        </dd>

        <dt class="col-sm-3">
            Supplier
        </dt>
        <dd class="col-sm-9">
            @Model.Supplier?.SupplierName
        </dd>

        <dt class="col-sm-3">
            Purchase Date
        </dt>
        <dd class="col-sm-9">
            @Model.PurchaseDate.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">
            Payment Status
        </dt>
        <dd class="col-sm-9">
            @switch (Model.PaymentStatus)
            {
                case PharmacyManagmentSystem.Models.PaymentStatus.Paid:
                    <span class="badge bg-success">Paid</span>
                    break;
                case PharmacyManagmentSystem.Models.PaymentStatus.Partial:
                    <span class="badge bg-warning text-dark">Partial</span>
                    break;
                default:
                    <span class="badge bg-danger">Pending</span>
                    break;
            }
        </dd>

        <dt class="col-sm-3">
            Notes
        </dt>
        <dd class="col-sm-9">
            @Model.Notes
        </dd>
    </dl>

    <h4>Purchase Items (Batch / Expiry Details)</h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Medicine</th>
                <th>Batch Number</th>
                <th>Expiry Date</th>
                <th>Quantity</th>
                <th>Purchase Price</th>
                <th>Selling Price</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rowNum = 1;
            }
            @foreach (var item in Model.PurchaseItems)
            {
                <tr>
                    <td>@rowNum</td>
                    <td>@item.Medicine?.MedicineName</td>
                    <td>@item.BatchNumber</td>
                    <td>
                        @if (item.ExpiryDate < DateTime.Today)
                        {
                            <span class="text-danger fw-bold">@item.ExpiryDate.ToString("dd-MM-yyyy") (Expired)</span>
                        }
                        else if (item.ExpiryDate < DateTime.Today.AddMonths(3))
                        {
                            <span class="text-warning fw-bold">@item.ExpiryDate.ToString("dd-MM-yyyy") (Expiring Soon)</span>
                        }
                        else
                        {
                            @item.ExpiryDate.ToString("dd-MM-yyyy")
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>₹@item.PurchasePrice.ToString("N2")</td>
                    <td>₹@item.SellingPrice.ToString("N2")</td>
                    <td>₹@item.Amount.ToString("N2")</td>
                </tr>
                rowNum++;
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="7" class="text-end fw-bold">Total Amount:</td>
                <td>₹@Model.TotalAmount.ToString("N2")</td>
            </tr>
            <tr>
                <td colspan="7" class="text-end fw-bold">Discount:</td>
                <td>₹@Model.Discount.ToString("N2")</td>
            </tr>
            <tr>
                <td colspan="7" class="text-end fw-bold">GST Amount:</td>
                <td>₹@Model.GSTAmount.ToString("N2")</td>
            </tr>
            <tr>
                <td colspan="7" class="text-end fw-bold">Net Amount:</td>
                <td class="fw-bold">₹@Model.NetAmount.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
</div>

<div>
    <a asp-action="Invoice"
       asp-route-id="@Model.PurchaseId"
       class="btn btn-success">View Invoice</a>

    <a asp-action="Index"
       class="btn btn-secondary">Back to List</a>
</div>
